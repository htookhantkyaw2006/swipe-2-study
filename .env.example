# ==============================================================================
# Swipe 2 Study — Frontend Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
#
# SECURITY RULES:
# - All VITE_* variables are baked into browser-facing JavaScript at build time.
# - NEVER put database passwords, service-role JWTs, or sb_secret_* keys here.
# - Changes to environment variables require a rebuild/restart to take effect.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SUPABASE BACKEND (Required for authenticated features and cloud storage)
# ------------------------------------------------------------------------------
# Obtain from your Supabase Project Settings -> API.
# Use the Project URL and the browser-safe 'anon' or 'publishable' key.
# When blank, the application runs in local-only Guest mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# 2. CANONICAL PUBLIC URL (Optional)
# ------------------------------------------------------------------------------
# Canonical production origin used for metadata, OpenGraph, and Twitter tags.
# Example: https://swipe2study.com or https://swipe2study.vercel.app
# If left blank, falls back dynamically to window.location.origin in browsers.
VITE_PUBLIC_URL=

# ------------------------------------------------------------------------------
# 3. FEATURE GATES (Safe Defaults: All Disabled)
# ------------------------------------------------------------------------------
# When 'false' or omitted, the application falls back safely to local/demo behavior.
# Enabling any gate requires a configured Supabase backend and its corresponding
# database migrations/Edge Functions to be applied on the hosted instance.

# Published HSK1/N5 Content: loads published course items from Supabase database.
# Prerequisite: migrations 20261030000100, 20261030000200, 20261030000300
# (tables: courses, vocabulary; stages/history in private schema; publication RPCs).
VITE_PUBLISHED_CONTENT_ENABLED=false

# Online Progress Sync: synchronizes vocabulary progress, actions, and daily streaks.
# Prerequisite: migrations 20261029000300, 20261029000400, 20261029000500, 20261029000600
# (tables: user_items, user_item_tombstones, user_study_streaks, user_study_activity;
#  RPCs: s2s_apply_mutations, s2s_get_study_streak).
VITE_ONLINE_SYNC_ENABLED=false

# Self-Service Account Deletion: exposes account deletion dialog in Settings.
# Prerequisite: migrations 20261029000100, 20261029000200, and delete-account Edge Function.
VITE_ACCOUNT_DELETION_ENABLED=false

# Learning Data Export & Reset: exposes cloud data export and account learning reset.
# Prerequisite: migrations 20261028000100, 20261029000300, 20261029000500, 20261029000600
# (snapshot RPC s2s_account_snapshot and reset RPC s2s_reset_learning, independently
# of whether background online sync is enabled).
VITE_ACCOUNT_EXPORT_RESET_ENABLED=false

# Account Preferences Cloud Sync: synchronizes user settings and language choices.
# Prerequisite: migration 20261027000100 (user_preferences table and RLS).
VITE_ACCOUNT_PREFERENCES_SYNC_ENABLED=false

# Google OAuth Sign-in: exposes Google login/signup button on auth forms.
# Prerequisite: Google Cloud OAuth client configured in Supabase Auth -> Providers -> Google.
VITE_GOOGLE_AUTH_ENABLED=false

# Cloud Guest Import Staging: enables cloud guest import staging RPC.
# Prerequisite: migrations 20261028000100, 20261029000300, 20261029000400
# (RPC s2s_import_guest and s2s_account_snapshot).
VITE_CLOUD_IMPORT_STAGING=false

# ------------------------------------------------------------------------------
# 4. OBSERVABILITY & TELEMETRY (Safe Defaults: All Disabled)
# ------------------------------------------------------------------------------
# Error Monitoring: centralized reporting for unhandled errors with sanitized payloads.
# Requires a valid collector endpoint URL when enabled.
VITE_ERROR_REPORTING_ENABLED=false
VITE_ERROR_REPORTING_URL=

# Analytics: privacy-conscious, allowlisted coarse event tracking.
# Requires a valid collector endpoint URL when enabled.
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_URL=
